# Copy to .env and fill in. .env is gitignored, never commit it.

# The Gmail mailbox that sends the message
GMAIL_USER=quantumdataleap.ai@gmail.com

# Where demo requests are delivered. Defaults to GMAIL_USER if unset.
MAIL_TO=quantumdataleap.ai@gmail.com

# From the OAuth client in Google Cloud Console, APIs & Services, Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Produced by: npm run mail:token
GOOGLE_REFRESH_TOKEN=

# Port the mail server listens on. Vite proxies /api here in development.
MAIL_PORT=8787

# Overrides the measurement ID in src/content/site.json. Leave unset to use
# that one; set it empty to switch GA off, which is what a preview wants.
# Either way the tag is injected only after analytics consent.
VITE_GA4_ID=
# Search Console HTML tag verification token.
# Only needed for a URL-prefix property, and it covers that one host alone.
# A Domain property verified by DNS TXT covers the apex and www together, which
# is the better fit here, and needs nothing set below.
VITE_GSC_VERIFICATION=
